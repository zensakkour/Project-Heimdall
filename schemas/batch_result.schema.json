{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HeimdallBatchResult",
  "type": "object",
  "properties": {
    "image": { "type": "string" },
    "result": {
      "type": "object",
      "properties": {
        "detections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "confidence": { "type": "number" },
              "heading_deg": { "type": ["number", "null"] },
              "shadow_azimuth_deg": { "type": ["number", "null"] },
              "shadow_length_ratio": { "type": ["number", "null"] },
              "obb": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": ["label", "confidence", "obb"]
          }
        },
        "geo": {
          "type": ["object", "null"],
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "confidence": { "type": "number" },
            "landmarks": {
              "type": ["array", "null"],
              "items": { "type": "string" }
            },
            "uncertainty_m": { "type": ["number", "null"] },
            "uncertainty_radius_m": { "type": ["number", "null"] },
            "confidence_tier": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          }
        },
        "verification": {
          "type": ["object", "null"],
          "properties": {
            "shadow_ok": { "type": "boolean" },
            "topo_ok": { "type": "boolean" },
            "notes": { "type": ["string", "null"] }
          }
        },
        "score": { "type": "number" }
      },
      "required": ["detections", "geo", "verification", "score"]
    }
  },
  "required": ["image", "result"]
}
