{
  "version": 1,
  "profiles": {
    "core": {
      "description": "Regression gates for the canonical geo benchmark suite.",
      "rules": [
        {
          "metric": "scenario.realistic_single.mean_km",
          "direction": "lower",
          "max_regression": 0.75
        },
        {
          "metric": "scenario.realistic_single.within_10km_pct",
          "direction": "higher",
          "max_regression": 2.0
        },
        {
          "metric": "scenario.candidate_multi.mean_km",
          "direction": "lower",
          "max_regression": 1.0
        },
        {
          "metric": "scenario.candidate_multi.within_10km_pct",
          "direction": "higher",
          "max_regression": 2.5
        }
      ]
    }
  }
}
